{
  "mcpServers": {
    "defense": {
      "command": "python3",
      "args": ["-m", "defense"],
      "env": {
        "DEFENSE_ALLOWED_TARGETS": "127.0.0.1/32",
        "DEFENSE_DENIED_TARGETS": "",
        "DEFENSE_RUN_DIR": "",
        "DEFENSE_ALLOW_RESPONSE": "0",
        "DEFENSE_ALLOW_INTERPRETER": "0",
        "DEFENSE_ALLOW_ANY_CMD": "0",
        "DEFENSE_TOKEN": "",
        "DEFENSE_BACKEND": "subprocess",
        "DEFENSE_SSH_USER": "root",
        "DEFENSE_WIN_HOSTS": ""
      }
    }
  }
}
